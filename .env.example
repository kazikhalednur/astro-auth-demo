# Supabase project URL (Project Settings → API → Project URL)
# Example: https://xxxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase anonymous/public key (Project Settings → API → anon public)
# Safe to expose in the browser; Row Level Security enforces access control.
SUPABASE_ANON_KEY=

# Server-only service role key (Project Settings → API → service_role)
# Local: run `supabase status` and copy SERVICE_ROLE_KEY
# Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret used to sign magic-link tokens (use a long random string)
MAGIC_LINK_SECRET=

# Magic link token lifetime in seconds (default 900 = 15 minutes)
MAGIC_LINK_EXPIRY_SECONDS=900

# Public site origin used in magic-link emails
PUBLIC_SITE_URL=http://localhost:4321

# Production only — same values as Supabase Dashboard → Auth → SMTP Settings
# Leave unset for local Supabase (magic link is printed to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
