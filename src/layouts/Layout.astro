---
const { title = "Auth", wide = false } = Astro.props;
const email = Astro.locals.email;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<div class="shell">
			<header class="topbar">
				<a class="brand" href="/">Auth</a>
				<nav class="nav" aria-label="Primary">
					{email ? (
						<>
							<span class="nav-email">{email}</span>
							<a href="/dashboard">Dashboard</a>
						</>
					) : (
						<>
							<a href="/signin">Sign in</a>
							<a class="nav-cta" href="/register">Register</a>
						</>
					)}
				</nav>
			</header>
			<main class:list={["main", { wide }]}>
				<slot />
			</main>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--ink: #152028;
		--ink-muted: #5a6b75;
		--paper: #f3f6f4;
		--paper-deep: #e4ebe7;
		--panel: rgba(255, 255, 255, 0.72);
		--line: rgba(21, 32, 40, 0.1);
		--accent: #0f6e6a;
		--accent-deep: #0a524f;
		--accent-soft: #d7efec;
		--danger: #9b2c2c;
		--danger-soft: #fce8e8;
		--ok: #1f6b3a;
		--ok-soft: #e5f5ea;
		--radius: 14px;
		--shadow: 0 18px 50px rgba(21, 32, 40, 0.08);
		--font-display: "Bricolage Grotesque", Georgia, serif;
		--font-body: "Manrope", system-ui, sans-serif;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		color-scheme: light;
	}

	body {
		margin: 0;
		min-height: 100vh;
		font-family: var(--font-body);
		color: var(--ink);
		background:
			radial-gradient(1200px 600px at 10% -10%, #cfe8e4 0%, transparent 55%),
			radial-gradient(900px 500px at 100% 0%, #dfe8f0 0%, transparent 50%),
			linear-gradient(160deg, var(--paper) 0%, var(--paper-deep) 100%);
		background-attachment: fixed;
		line-height: 1.55;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: var(--accent-deep);
		text-decoration-thickness: 1.5px;
		text-underline-offset: 3px;
		transition: color 0.15s ease;
	}

	a:hover {
		color: var(--accent);
	}

	.shell {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.1rem clamp(1.25rem, 4vw, 2.5rem);
		border-bottom: 1px solid var(--line);
		backdrop-filter: blur(10px);
		background: rgba(243, 246, 244, 0.7);
		position: sticky;
		top: 0;
		z-index: 10;
	}

	.brand {
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		color: var(--ink);
		text-decoration: none;
	}

	.brand:hover {
		color: var(--accent);
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		font-size: 0.92rem;
		font-weight: 500;
	}

	.nav a {
		text-decoration: none;
		color: var(--ink-muted);
	}

	.nav a:hover {
		color: var(--ink);
	}

	.nav-email {
		display: none;
		color: var(--ink-muted);
		font-size: 0.85rem;
		max-width: 16rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	@media (min-width: 640px) {
		.nav-email {
			display: inline;
		}
	}

	.nav-cta {
		padding: 0.45rem 0.9rem;
		border-radius: 999px;
		background: var(--ink);
		color: #fff !important;
		text-decoration: none !important;
	}

	.nav-cta:hover {
		background: var(--accent);
	}

	.main {
		flex: 1;
		width: min(100%, 440px);
		margin: 0 auto;
		padding: clamp(2rem, 6vw, 3.5rem) 1.25rem 3rem;
	}

	.main.wide {
		width: min(100%, 720px);
		padding-top: 0;
	}

	.page-hero {
		margin-bottom: 1.75rem;
		animation: rise 0.55s ease both;
	}

	.page-hero h1 {
		margin: 0 0 0.4rem;
		font-family: var(--font-display);
		font-size: clamp(1.85rem, 4vw, 2.35rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1.15;
	}

	.page-hero p {
		margin: 0;
		color: var(--ink-muted);
		font-size: 1rem;
	}

	.page-hero .lede {
		margin-top: 0.65rem;
		max-width: 28rem;
	}

	.panel {
		padding: 1.5rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--panel);
		box-shadow: var(--shadow);
		backdrop-filter: blur(12px);
		animation: rise 0.55s ease 0.08s both;
	}

	.panel + .panel {
		margin-top: 1rem;
	}

	.panel h2 {
		margin: 0 0 1rem;
		font-family: var(--font-display);
		font-size: 1.1rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.stack {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.field label {
		font-size: 0.84rem;
		font-weight: 600;
		color: var(--ink);
	}

	.field input {
		width: 100%;
		padding: 0.7rem 0.85rem;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: #fff;
		color: var(--ink);
		font: inherit;
		font-size: 0.98rem;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease;
	}

	.field input:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 3px var(--accent-soft);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		align-items: center;
		margin-top: 0.25rem;
	}

	button,
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		padding: 0.7rem 1.15rem;
		border: none;
		border-radius: 10px;
		background: var(--accent);
		color: #fff;
		font: inherit;
		font-size: 0.95rem;
		font-weight: 600;
		cursor: pointer;
		text-decoration: none;
		transition:
			background 0.15s ease,
			transform 0.15s ease;
	}

	button:hover,
	.btn:hover {
		background: var(--accent-deep);
		color: #fff;
	}

	button:active,
	.btn:active {
		transform: translateY(1px);
	}

	.btn-ghost {
		background: transparent;
		color: var(--ink-muted);
		border: 1px solid var(--line);
	}

	.btn-ghost:hover {
		background: rgba(255, 255, 255, 0.7);
		color: var(--ink);
	}

	.btn-block {
		width: 100%;
	}

	.alert {
		padding: 0.75rem 0.9rem;
		border-radius: 10px;
		font-size: 0.92rem;
		margin-bottom: 1rem;
		animation: rise 0.4s ease both;
	}

	.alert-error {
		background: var(--danger-soft);
		color: var(--danger);
	}

	.alert-ok {
		background: var(--ok-soft);
		color: var(--ok);
	}

	.alert-info {
		background: var(--accent-soft);
		color: var(--accent-deep);
	}

	.meta-links {
		margin-top: 1.1rem;
		font-size: 0.9rem;
		color: var(--ink-muted);
	}

	.meta-links a {
		font-weight: 600;
	}

	.divider {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 1.25rem 0 0.25rem;
		color: var(--ink-muted);
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.divider::before,
	.divider::after {
		content: "";
		flex: 1;
		height: 1px;
		background: var(--line);
	}

	.home-stage {
		margin: 0 auto;
		padding: clamp(2.5rem, 10vh, 5rem) 0 2rem;
		text-align: left;
	}

	.home-stage .brand-mark {
		font-family: var(--font-display);
		font-size: clamp(3rem, 10vw, 5.5rem);
		font-weight: 700;
		letter-spacing: -0.06em;
		line-height: 0.95;
		margin: 0 0 1rem;
		background: linear-gradient(120deg, var(--ink) 30%, var(--accent) 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: rise 0.6s ease both;
	}

	.home-stage h1 {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 3vw, 1.75rem);
		font-weight: 500;
		letter-spacing: -0.03em;
		color: var(--ink);
		animation: rise 0.6s ease 0.08s both;
	}

	.home-stage .lede {
		margin: 0 0 1.75rem;
		max-width: 28rem;
		color: var(--ink-muted);
		font-size: 1.05rem;
		animation: rise 0.6s ease 0.14s both;
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		animation: rise 0.6s ease 0.22s both;
	}

	.signed-in-note {
		margin-top: 1.25rem;
		color: var(--ink-muted);
		font-size: 0.95rem;
		animation: rise 0.6s ease 0.28s both;
	}

	.panel-copy {
		margin: 0 0 1.25rem;
		color: var(--ink-muted);
	}

	.panel-copy:last-child {
		margin-bottom: 0;
	}

	.inline-form {
		margin: 0;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation: none !important;
			transition: none !important;
		}
	}
</style>
