---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { ensureCsrfToken } from "../lib/csrf";
import { MIN_PASSWORD_LENGTH } from "../lib/validation";

const csrf = ensureCsrfToken(Astro.cookies);
const magic = Astro.url.searchParams.get("magic");
const error = Astro.url.searchParams.get("error");
const registered = Astro.url.searchParams.get("registered");
const passwordReset = Astro.url.searchParams.get("password_reset");
const signedOut = Astro.url.searchParams.get("signed_out");

const magicMessages = {
  sent: "Check your email for the login link. If you are using local Supabase, check the dev server console.",
  resent:
    "That link had expired, so we sent a new one. Check your email (or the dev server console for local Supabase).",
};

const errorMessages = {
  email_required: "Email is required.",
  email_invalid: "Enter a valid email address.",
  password_required: "Password is required.",
  password_too_short: `Password must be at least ${MIN_PASSWORD_LENGTH} characters.`,
  magic_link_failed: "Could not send the magic link. Try again.",
  invalid_or_expired_link: "That magic link is invalid or has expired.",
  invalid_credentials: "Invalid email or password.",
  rate_limited: "Too many attempts. Please wait a few minutes and try again.",
  csrf: "Your session expired. Please try again.",
};
---

<Layout title="Sign in">
  <div class="page-hero">
    <h1>Sign in</h1>
    <p>Welcome back. Use a password or a magic link.</p>
  </div>

  {registered && <p class="alert alert-ok">Account created. You can sign in now.</p>}
  {passwordReset && <p class="alert alert-ok">Password updated. You can sign in now.</p>}
  {signedOut && <p class="alert alert-info">You have been signed out.</p>}
  {magic && magicMessages[magic] && <p class="alert alert-info">{magicMessages[magic]}</p>}
  {error && <p class="alert alert-error">{errorMessages[error] || "Something went wrong."}</p>}

  <div class="panel">
    <h2>Email and password</h2>
    <form class="stack" action="/api/auth/signin" method="post">
      <input type="hidden" name="csrf" value={csrf} />
      <div class="field">
        <label for="email">Email</label>
        <input type="email" name="email" id="email" required autocomplete="email" />
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input
          type="password"
          name="password"
          id="password"
          required
          minlength={MIN_PASSWORD_LENGTH}
          autocomplete="current-password"
        />
      </div>
      <button class="btn-block" type="submit">Login</button>
    </form>
    <p class="meta-links">
      <a href="/forgot-password">Forgot your password?</a>
      · New here? <a href="/register">Create an account</a>
    </p>
  </div>

  <div class="divider">or</div>

  <div class="panel">
    <h2>Magic link</h2>
    <form class="stack" action="/api/auth/magic-link" method="post">
      <input type="hidden" name="csrf" value={csrf} />
      <div class="field">
        <label for="magic-email">Email</label>
        <input type="email" name="email" id="magic-email" required autocomplete="email" />
      </div>
      <button class="btn-block" type="submit">Email me a login link</button>
    </form>
  </div>
</Layout>
