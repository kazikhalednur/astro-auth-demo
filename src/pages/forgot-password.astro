---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { ensureCsrfToken } from "../lib/csrf";

const csrf = ensureCsrfToken(Astro.cookies);
const error = Astro.url.searchParams.get("error");
const sent = Astro.url.searchParams.get("sent");

const errorMessages = {
  email_required: "Email is required.",
  email_invalid: "Enter a valid email address.",
  rate_limited: "Too many attempts. Please wait a few minutes and try again.",
  csrf: "Your session expired. Please try again.",
  reset_failed: "Could not start a password reset. Try again.",
  invalid_reset_link: "That reset link is invalid or has expired.",
};
---

<Layout title="Forgot password">
  <div class="page-hero">
    <h1>Forgot password</h1>
    <p><a href="/signin">Back to sign in</a></p>
  </div>

  {sent && (
    <p class="alert alert-info">
      If an account exists for that email, we sent a reset link. For local Supabase,
      check the dev server console.
    </p>
  )}
  {error && <p class="alert alert-error">{errorMessages[error] || "Something went wrong."}</p>}

  <div class="panel">
    <form class="stack" action="/api/auth/forgot-password" method="post">
      <input type="hidden" name="csrf" value={csrf} />
      <div class="field">
        <label for="email">Email</label>
        <input type="email" name="email" id="email" required autocomplete="email" />
      </div>
      <button class="btn-block" type="submit">Send reset link</button>
    </form>
  </div>
</Layout>
