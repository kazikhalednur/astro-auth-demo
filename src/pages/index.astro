---
export const prerender = false;
import Layout from "../layouts/Layout.astro";

const email = Astro.locals.email;
---

<Layout title="Auth" wide>
  <div class="home-stage">
    <p class="brand-mark">Auth</p>
    <h1>Sign in without the friction.</h1>
    <p class="lede">
      Magic links, email and password, and a protected dashboard — a small SSR demo on Astro and Supabase.
    </p>
    {email ? (
      <>
        <div class="cta-row">
          <a class="btn" href="/dashboard">Go to dashboard</a>
        </div>
        <p class="signed-in-note">Signed in as {email}</p>
      </>
    ) : (
      <div class="cta-row">
        <a class="btn" href="/signin">Sign in</a>
        <a class="btn btn-ghost" href="/register">Create an account</a>
      </div>
    )}
  </div>
</Layout>
