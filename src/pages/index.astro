---
export const prerender = false;
import Layout from "../layouts/Layout.astro";

const email = Astro.locals.email;
---

<Layout title="Home">
  <h1>Authentication demo</h1>
  {email ? (
    <p>
      Signed in as {email}. <a href="/dashboard">Go to dashboard</a>
    </p>
  ) : (
    <p>
      <a href="/signin">Sign in</a> · <a href="/register">Create an account</a>
    </p>
  )}
</Layout>
