---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { ensureCsrfToken } from "../lib/csrf";
import { MIN_PASSWORD_LENGTH } from "../lib/validation";

const csrf = ensureCsrfToken(Astro.cookies);
const error = Astro.url.searchParams.get("error");

const errorMessages = {
  password_required: "Password is required.",
  password_too_short: `Password must be at least ${MIN_PASSWORD_LENGTH} characters.`,
  password_mismatch: "Passwords do not match.",
  set_password_failed: "Could not save your password. Try again.",
  csrf: "Your session expired. Please try again.",
};
---

<Layout title="Set password">
  <div class="page-hero">
    <h1>Set a password</h1>
    <p>
      Choose a password so you can also sign in with email and password.
    </p>
  </div>

  {error && <p class="alert alert-error">{errorMessages[error] || "Something went wrong."}</p>}

  <div class="panel">
    <form class="stack" action="/api/auth/set-password" method="post">
      <input type="hidden" name="csrf" value={csrf} />
      <div class="field">
        <label for="password">Password (min {MIN_PASSWORD_LENGTH} characters)</label>
        <input
          type="password"
          name="password"
          id="password"
          required
          minlength={MIN_PASSWORD_LENGTH}
          autocomplete="new-password"
        />
      </div>
      <div class="field">
        <label for="confirm">Confirm password</label>
        <input
          type="password"
          name="confirm"
          id="confirm"
          required
          minlength={MIN_PASSWORD_LENGTH}
          autocomplete="new-password"
        />
      </div>
      <button class="btn-block" type="submit">Save password</button>
    </form>
    <p class="meta-links"><a href="/dashboard">Back to dashboard</a></p>
  </div>
</Layout>
