---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { ensureCsrfToken } from "../lib/csrf";
import { MIN_PASSWORD_LENGTH } from "../lib/validation";

const csrf = ensureCsrfToken(Astro.cookies);
const error = Astro.url.searchParams.get("error");

const errorMessages = {
  password_required: "Password is required.",
  password_too_short: `Password must be at least ${MIN_PASSWORD_LENGTH} characters.`,
  password_mismatch: "Passwords do not match.",
  set_password_failed: "Could not save your password. Try again.",
  csrf: "Your session expired. Please try again.",
};
---

<Layout title="Set password">
  <h1>Set a password</h1>
  <p>
    Choose a password so you can also sign in with email and password (useful if you
    first signed in with a magic link).
  </p>
  <p><a href="/dashboard">Back to dashboard</a></p>

  {error && <p>{errorMessages[error] || "Something went wrong."}</p>}

  <form action="/api/auth/set-password" method="post">
    <input type="hidden" name="csrf" value={csrf} />
    <label for="password">Password (min {MIN_PASSWORD_LENGTH} characters)</label>
    <input
      type="password"
      name="password"
      id="password"
      required
      minlength={MIN_PASSWORD_LENGTH}
    />
    <label for="confirm">Confirm password</label>
    <input
      type="password"
      name="confirm"
      id="confirm"
      required
      minlength={MIN_PASSWORD_LENGTH}
    />
    <button type="submit">Save password</button>
  </form>
</Layout>
