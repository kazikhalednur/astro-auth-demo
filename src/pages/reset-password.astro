---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { ensureCsrfToken } from "../lib/csrf";
import { peekPasswordResetToken } from "../lib/magic-link";
import { MIN_PASSWORD_LENGTH } from "../lib/validation";

const csrf = ensureCsrfToken(Astro.cookies);
const token = Astro.url.searchParams.get("token") || "";
const error = Astro.url.searchParams.get("error");

let tokenValid = false;
try {
  if (token) {
    await peekPasswordResetToken(token);
    tokenValid = true;
  }
} catch {
  tokenValid = false;
}

const errorMessages = {
  password_required: "Password is required.",
  password_too_short: `Password must be at least ${MIN_PASSWORD_LENGTH} characters.`,
  password_mismatch: "Passwords do not match.",
  csrf: "Your session expired. Please try again.",
};
---

<Layout title="Reset password">
  <div class="page-hero">
    <h1>Reset password</h1>
    <p>Choose a new password for your account.</p>
  </div>

  {!tokenValid ? (
    <div class="panel">
      <p class="panel-copy">
        That reset link is invalid or has expired.
        <a href="/forgot-password">Request a new one</a>.
      </p>
    </div>
  ) : (
    <>
      {error && <p class="alert alert-error">{errorMessages[error] || "Something went wrong."}</p>}
      <div class="panel">
        <form class="stack" action="/api/auth/reset-password" method="post">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="token" value={token} />
          <div class="field">
            <label for="password">New password (min {MIN_PASSWORD_LENGTH} characters)</label>
            <input
              type="password"
              name="password"
              id="password"
              required
              minlength={MIN_PASSWORD_LENGTH}
              autocomplete="new-password"
            />
          </div>
          <div class="field">
            <label for="confirm">Confirm password</label>
            <input
              type="password"
              name="confirm"
              id="confirm"
              required
              minlength={MIN_PASSWORD_LENGTH}
              autocomplete="new-password"
            />
          </div>
          <button class="btn-block" type="submit">Update password</button>
        </form>
      </div>
    </>
  )}
</Layout>
